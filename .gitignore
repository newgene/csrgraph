# Byte-compiled / optimized / cached files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Generated graph / metadata stores
*.lmdb/
*.memmap/
*.sqlite
*.duckdb
*.pkl
*.pkl.zst

# Release directories from make_release.py.  The stores and snapshots inside are
# already covered above, but the memmap dir and manifest.json are not, so a
# release built with --out-root inside the repo would leave those visible.
/releases/

# Generated query output / scratch
csr_test_result.json
mg_test.html

# Generated kg_report.py HTML reports
*_report.html

# Generated audit reports (predicate_audit.py output)
*predicate_audit*.html

# Local Claude Code harness state
.claude/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
